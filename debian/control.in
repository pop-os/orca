Package: gnome-orca
Architecture: all
Depends: ${misc:Depends},
         ${python:Depends},
         libgnome-speech7 (>= 0.4.11),
         libgail-gnome-module,
         python-pyatspi2 | python-pyatspi (>= 1.22.0),
         python-gtk2 (>= 2.10),
         python-gnome2 (>= 2.6.2),
